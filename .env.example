# =============================================================================
# Application Environment
# =============================================================================

# Application mode (development, production, test)
NODE_ENV=development

# Custom application environment
APP_ENV=development

# Your application's display name
APP_NAME="My Awesome Website"

# =============================================================================
# Website Metadata
# =============================================================================

# Website name
SITE_NAME="My Awesome Website"

# Author or organization
SITE_AUTHOR="Jane Doe"

# Short description (used for SEO and social sharing)
SITE_DESCRIPTION="A modern website built with Next.js and TinaCMS."

# Contact email
SITE_EMAIL=hello@example.com

# LinkedIn profile or company page
SITE_LINKEDIN=https://www.linkedin.com/in/janedoe

# Production website URL (no trailing slash)
SITE_URL=https://www.example.com

# Base path:
# /      = site hosted at root
# /blog  = site hosted at https://example.com/blog
SITE_BASEURL=/

# Redirect HTTP to HTTPS
# true  = enforce HTTPS
# false = allow HTTP
SITE_ENFORCE_SSL=true

# =============================================================================
# Google Analytics
# =============================================================================

# Universal Analytics (Legacy)
# Leave blank unless you still use UA tracking.
# Example: UA-123456789-1
GOOGLE_ANALYTICS=

# Google Analytics 4 Measurement ID
# Example: G-ABCDEF1234
GOOGLE_ANALYTICS_GA4=G-ABCDEF1234

# =============================================================================
# Umami Analytics (if you decide to use it instead of Google Analytics)
# =============================================================================

# Website ID from Umami dashboard
# Example: 0a1b2c3d-4e5f-6789-abcd-ef0123456789
UMAMI_CLIENT_ID=0a1b2c3d-4e5f-6789-abcd-ef0123456789

# Analytics server hostname
# Cloud:
# cloud.umami.is
#
# Self-hosted example:
# analytics.example.com
UMAMI_DOMAIN=cloud.umami.is

# =============================================================================
# Notes
# =============================================================================
#
# 1. Save this file as .env.local
# 2. Never commit .env.local to Git.
# 3. Replace all example values with your own.
# 4. Restart your development server after changing environment variables.
# 5. Keep API keys and tokens secret.
#
# Example:
# npm run dev
# pnpm dev
# yarn dev
#
# .gitignore should contain:
# .env.local
# .env
# .env.production
#
# =============================================================================